{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "cloudflare-ai-web",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		// Non-secret runtime configuration; secrets (e.g. CF_WORKERS_AI_TOKEN)
		// are set with `wrangler secret put` or in the Cloudflare dashboard.
		"CF_ACCOUNT_ID": "5dbfeeed2915872f0855a916283d82c4"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
